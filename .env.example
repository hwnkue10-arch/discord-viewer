# 디스코드 개발자 포털 (https://discord.com/developers/applications) 에서 발급받은 정보 입력
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# 로컬 액티비티 쉘 서버 포트 (기본값: 3000)
PORT=3000

# 외부 터널 주소 (Cloudflare Tunnel 사용 시 입력, 예: https://xxxx.trycloudflare.com)
PUBLIC_ACTIVITY_URL=
