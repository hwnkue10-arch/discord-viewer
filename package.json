{
  "name": "discord-viewer",
  "version": "1.1.0",
  "description": "Discord In-App Activity & Real-time Viewer (HTML, PDF, Markdown & PPTX)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register": "node scripts/register_commands.js",
    "deploy": "npx wrangler deploy",
    "deploy:secret": "npx wrangler secret put DISCORD_BOT_TOKEN"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord-activity",
    "html-renderer",
    "pdf-viewer",
    "markdown-viewer",
    "pptx-viewer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discord/embedded-app-sdk": "^1.8.0",
    "cors": "^2.8.5",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
